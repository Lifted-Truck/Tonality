#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# THIS FILE IS PROJECT-OWNED: edit `fast` and `full` freely, add project gates,
# wire your test commands. The kit-owned gates live in `.kit/kit-gates.sh`,
# which is vendored and checksummed — do not edit that one, and do not copy its
# contents here. Update it with:  python3 <kit>/kit_sync.py .
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  local ok=0
  kit_integrity || ok=1      # kit-owned files must match .kit/MANIFEST
  leak_gate     || ok=1      # privacy gate: kit-core, keep it first
  plant_not_tracked || ok=1   # project gate — see below

  # The dev suite IS the fast oracle here: it carries the conformance golden,
  # the tool-manifest pin, the port-pin fingerprint, and the repo's own
  # machine-identity test. Seconds, and it is what the Stop hook already runs.
  "$(pybin)" -m pytest tests/ -q || ok=1
  [ "$ok" -eq 0 ] && echo "verify[fast]: green"
  return "$ok"
}

# The engine venv, per CLAUDE.md: there is no bare `python` on the dev machine.
pybin() {
  if [ -x .venv/bin/python3.13 ]; then echo .venv/bin/python3.13
  elif [ -x .venv/bin/python ]; then echo .venv/bin/python
  else command -v python3
  fi
}

# Kit 2.3.0 keeps `.kit-currency-plant-*` INVISIBLE to leak_gate so a concurrent
# session is not reddened by another run's probe. That opens one hole: an
# orphaned plant is untracked AND unignored, so a careless `git add -A` could
# commit identity paths the gate now ignores by design. Do NOT close it with a
# .gitignore line — `git grep --untracked` skips ignored files, which would
# blind the probe that OWNS the run and silently no-op the whole gate-fires
# check. Instead: fail if a plant is ever TRACKED. Kept outside leak_gate so
# the kit-owned function stays byte-identical across all three detectors.
plant_not_tracked() {
  local hits
  hits=$(git ls-files -- '.kit-currency-plant-*' 2>/dev/null)
  if [ -n "$hits" ]; then
    echo "plant_not_tracked: a currency probe plant is TRACKED — remove it:" >&2
    echo "$hits" >&2
    return 1
  fi
  return 0
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # The audit invariants are fenced OUT of the dev suite on purpose
  # (`testpaths = ["tests"]`), so `fast` never runs them; CI does, and so does
  # this. Then ci-local.sh — the real two-leg, two-interpreter reproduction,
  # which reports honestly when it cannot reproduce a leg.
  local ok=0
  "$(pybin)" -m pytest audit/checks/ -q || ok=1
  bash scripts/ci-local.sh || ok=1
  [ "$ok" -eq 0 ] && echo "verify[full]: green"
  return "$ok"
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
